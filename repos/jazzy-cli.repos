repositories:
  # CLI tools — ros2 topic/node/service/param/interface
  ros2/ros2cli:
    type: git
    url: https://github.com/ros2/ros2cli.git
    version: jazzy
  ros2/rclpy:
    type: git
    url: https://github.com/ros2/rclpy.git
    version: jazzy
  ros2/rosidl_python:
    type: git
    url: https://github.com/ros2/rosidl_python.git
    version: jazzy
  ros2/rosidl_runtime_py:
    type: git
    url: https://github.com/ros2/rosidl_runtime_py.git
    version: jazzy
  ros2/python_cmake_module:
    type: git
    url: https://github.com/ros2/python_cmake_module.git
    version: jazzy
  ros2/rpyutils:
    type: git
    url: https://github.com/ros2/rpyutils.git
    version: jazzy
  # pybind11_vendor (CLI profile) + offline upstream
  ros2/pybind11_vendor:
    type: git
    url: https://github.com/ros2/pybind11_vendor.git
    version: jazzy
  ros2/pybind11_vendor/pybind11_src:
    type: git
    url: https://github.com/pybind/pybind11.git
    version: v2.11.1
